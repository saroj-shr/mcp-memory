# Caddy reverse proxy configuration
# For local development (HTTP). When adding a domain, replace :80 with the domain
# and Caddy will auto-provision HTTPS via Let's Encrypt.

:80 {
	# REST API + auth endpoints
	handle /api/* {
		reverse_proxy mcp-server:3001
	}

	# MCP SSE endpoint — validate any bearer token (JWT or UI-generated API key) before proxying
	handle /mcp/* {
		forward_auth mcp-server:3001 {
			uri /api/auth/verify
			copy_headers Authorization
		}
		uri strip_prefix /mcp
		reverse_proxy mcp-server:3000
	}

	# MCP messages back-channel (session POSTs from VS Code after SSE handshake)
	handle /messages/* {
		forward_auth mcp-server:3001 {
			uri /api/auth/verify
			copy_headers Authorization
		}
		reverse_proxy mcp-server:3000
	}

	# Health check (no auth)
	handle /health {
		reverse_proxy mcp-server:3001
	}

	# Frontend (Next.js)
	handle {
		reverse_proxy frontend:3000
	}
}
